{%- liquid
  assign eyebrow_color_pc = section.settings.eyebrow_color_pc | default: '#ffffff'
  assign eyebrow_color_sp = section.settings.eyebrow_color_sp | default: '#ffffff'
  assign title_color_pc = section.settings.title_color_pc | default: '#ffffff'
  assign title_color_sp = section.settings.title_color_sp | default: '#ffffff'
  assign aspect_ratio_pc = section.settings.aspect_ratio_pc | default: '21 / 9'
  assign aspect_ratio_sp = section.settings.aspect_ratio_sp | default: '4 / 5'

  assign logo_width_pc = section.settings.logo_width_pc | default: 6
  assign logo_width_sp = section.settings.logo_width_sp | default: 11

  assign content_max_width = section.settings.content_max_width | default: 700

  # ロゴ 横位置（PC）
  assign logo_h_offset_pc = section.settings.logo_horizontal_offset_pc | default: 5
  case section.settings.logo_horizontal_align_pc
    when 'left'
      assign logo_left_pc = logo_h_offset_pc | append: '%'
      assign logo_right_pc = 'auto'
      assign logo_h_transform_pc = ''
    when 'right'
      assign logo_left_pc = 'auto'
      assign logo_right_pc = logo_h_offset_pc | append: '%'
      assign logo_h_transform_pc = ''
    else
      assign logo_left_pc = '50%'
      assign logo_right_pc = 'auto'
      assign logo_h_transform_pc = 'translateX(-50%)'
  endcase

  # ロゴ 縦位置（PC）
  assign logo_v_offset_pc = section.settings.logo_vertical_offset_pc | default: 5
  case section.settings.logo_vertical_align_pc
    when 'top'
      assign logo_top_pc = logo_v_offset_pc | append: '%'
      assign logo_bottom_pc = 'auto'
      assign logo_v_transform_pc = ''
    when 'bottom'
      assign logo_top_pc = 'auto'
      assign logo_bottom_pc = logo_v_offset_pc | append: '%'
      assign logo_v_transform_pc = ''
    else
      assign logo_top_pc = '50%'
      assign logo_bottom_pc = 'auto'
      assign logo_v_transform_pc = 'translateY(-50%)'
  endcase

  assign logo_transform_pc = logo_h_transform_pc | append: ' ' | append: logo_v_transform_pc | strip
  if logo_transform_pc == blank
    assign logo_transform_pc = 'none'
  endif

  # ロゴ 横位置（SP）
  assign logo_h_offset_sp = section.settings.logo_horizontal_offset_sp | default: 5
  case section.settings.logo_horizontal_align_sp
    when 'left'
      assign logo_left_sp = logo_h_offset_sp | append: '%'
      assign logo_right_sp = 'auto'
      assign logo_h_transform_sp = ''
    when 'right'
      assign logo_left_sp = 'auto'
      assign logo_right_sp = logo_h_offset_sp | append: '%'
      assign logo_h_transform_sp = ''
    else
      assign logo_left_sp = '50%'
      assign logo_right_sp = 'auto'
      assign logo_h_transform_sp = 'translateX(-50%)'
  endcase

  # ロゴ 縦位置（SP）
  assign logo_v_offset_sp = section.settings.logo_vertical_offset_sp | default: 5
  case section.settings.logo_vertical_align_sp
    when 'top'
      assign logo_top_sp = logo_v_offset_sp | append: '%'
      assign logo_bottom_sp = 'auto'
      assign logo_v_transform_sp = ''
    when 'bottom'
      assign logo_top_sp = 'auto'
      assign logo_bottom_sp = logo_v_offset_sp | append: '%'
      assign logo_v_transform_sp = ''
    else
      assign logo_top_sp = '50%'
      assign logo_bottom_sp = 'auto'
      assign logo_v_transform_sp = 'translateY(-50%)'
  endcase

  assign logo_transform_sp = logo_h_transform_sp | append: ' ' | append: logo_v_transform_sp | strip
  if logo_transform_sp == blank
    assign logo_transform_sp = 'none'
  endif

  # 小見出し・タイトル 横位置（PC）
  assign content_h_offset_pc = section.settings.content_horizontal_offset_pc | default: 5
  case section.settings.content_horizontal_align_pc
    when 'left'
      assign content_left_pc = content_h_offset_pc | append: '%'
      assign content_right_pc = 'auto'
      assign content_h_transform_pc = ''
      assign content_text_align_pc = 'left'
    when 'right'
      assign content_left_pc = 'auto'
      assign content_right_pc = content_h_offset_pc | append: '%'
      assign content_h_transform_pc = ''
      assign content_text_align_pc = 'right'
    else
      assign content_left_pc = '50%'
      assign content_right_pc = 'auto'
      assign content_h_transform_pc = 'translateX(-50%)'
      assign content_text_align_pc = 'center'
  endcase

  # 小見出し・タイトル 縦位置（PC）
  assign content_v_offset_pc = section.settings.content_vertical_offset_pc | default: 5
  case section.settings.content_vertical_align_pc
    when 'top'
      assign content_top_pc = content_v_offset_pc | append: '%'
      assign content_bottom_pc = 'auto'
      assign content_v_transform_pc = ''
    when 'bottom'
      assign content_top_pc = 'auto'
      assign content_bottom_pc = content_v_offset_pc | append: '%'
      assign content_v_transform_pc = ''
    else
      assign content_top_pc = '50%'
      assign content_bottom_pc = 'auto'
      assign content_v_transform_pc = 'translateY(-50%)'
  endcase

  assign content_transform_pc = content_h_transform_pc | append: ' ' | append: content_v_transform_pc | strip
  if content_transform_pc == blank
    assign content_transform_pc = 'none'
  endif

  # 小見出し・タイトル 横位置（SP）
  assign content_h_offset_sp = section.settings.content_horizontal_offset_sp | default: 5
  case section.settings.content_horizontal_align_sp
    when 'left'
      assign content_left_sp = content_h_offset_sp | append: '%'
      assign content_right_sp = 'auto'
      assign content_h_transform_sp = ''
      assign content_text_align_sp = 'left'
    when 'right'
      assign content_left_sp = 'auto'
      assign content_right_sp = content_h_offset_sp | append: '%'
      assign content_h_transform_sp = ''
      assign content_text_align_sp = 'right'
    else
      assign content_left_sp = '50%'
      assign content_right_sp = 'auto'
      assign content_h_transform_sp = 'translateX(-50%)'
      assign content_text_align_sp = 'center'
  endcase

  # 小見出し・タイトル 縦位置（SP）
  assign content_v_offset_sp = section.settings.content_vertical_offset_sp | default: 5
  case section.settings.content_vertical_align_sp
    when 'top'
      assign content_top_sp = content_v_offset_sp | append: '%'
      assign content_bottom_sp = 'auto'
      assign content_v_transform_sp = ''
    when 'bottom'
      assign content_top_sp = 'auto'
      assign content_bottom_sp = content_v_offset_sp | append: '%'
      assign content_v_transform_sp = ''
    else
      assign content_top_sp = '50%'
      assign content_bottom_sp = 'auto'
      assign content_v_transform_sp = 'translateY(-50%)'
  endcase

  assign content_transform_sp = content_h_transform_sp | append: ' ' | append: content_v_transform_sp | strip
  if content_transform_sp == blank
    assign content_transform_sp = 'none'
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #LpHero-{{ section.id }} {
    --lp-hero-ratio: {{ aspect_ratio_sp }};
    --lp-hero-eyebrow-color: {{ eyebrow_color_sp }};
    --lp-hero-eyebrow-size: {{ section.settings.eyebrow_font_size_sp | default: 1.7 }}vw;
    --lp-hero-title-color: {{ title_color_sp }};
    --lp-hero-title-size: {{ section.settings.title_font_size_sp | default: 4.3 }}vw;

    --lp-hero-logo-width: {{ logo_width_sp }}vw;
    --lp-hero-logo-top: {{ logo_top_sp }};
    --lp-hero-logo-bottom: {{ logo_bottom_sp }};
    --lp-hero-logo-left: {{ logo_left_sp }};
    --lp-hero-logo-right: {{ logo_right_sp }};
    --lp-hero-logo-transform: {{ logo_transform_sp }};

    --lp-hero-content-max-width: {{ content_max_width }}px;
    --lp-hero-content-top: {{ content_top_sp }};
    --lp-hero-content-bottom: {{ content_bottom_sp }};
    --lp-hero-content-left: {{ content_left_sp }};
    --lp-hero-content-right: {{ content_right_sp }};
    --lp-hero-content-transform: {{ content_transform_sp }};
    --lp-hero-text-align: {{ content_text_align_sp }};
  }

  @media screen and (min-width: 750px) {
    #LpHero-{{ section.id }} {
      --lp-hero-ratio: {{ aspect_ratio_pc }};
      --lp-hero-eyebrow-color: {{ eyebrow_color_pc }};
      --lp-hero-eyebrow-size: {{ section.settings.eyebrow_font_size_pc | default: 0.8 }}vw;
      --lp-hero-title-color: {{ title_color_pc }};
      --lp-hero-title-size: {{ section.settings.title_font_size_pc | default: 2.9 }}vw;

      --lp-hero-logo-width: {{ logo_width_pc }}vw;
      --lp-hero-logo-top: {{ logo_top_pc }};
      --lp-hero-logo-bottom: {{ logo_bottom_pc }};
      --lp-hero-logo-left: {{ logo_left_pc }};
      --lp-hero-logo-right: {{ logo_right_pc }};
      --lp-hero-logo-transform: {{ logo_transform_pc }};

      --lp-hero-content-top: {{ content_top_pc }};
      --lp-hero-content-bottom: {{ content_bottom_pc }};
      --lp-hero-content-left: {{ content_left_pc }};
      --lp-hero-content-right: {{ content_right_pc }};
      --lp-hero-content-transform: {{ content_transform_pc }};
      --lp-hero-text-align: {{ content_text_align_pc }};
    }
  }

  #LpHero-{{ section.id }} .lp-hero__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--lp-hero-ratio);
  }
  #LpHero-{{ section.id }} .lp-hero__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #LpHero-{{ section.id }} .lp-hero__logo {
    position: absolute;
    width: var(--lp-hero-logo-width);
    top: var(--lp-hero-logo-top);
    bottom: var(--lp-hero-logo-bottom);
    left: var(--lp-hero-logo-left);
    right: var(--lp-hero-logo-right);
    transform: var(--lp-hero-logo-transform);
  }
  #LpHero-{{ section.id }} .lp-hero__logo img {
    display: block;
    width: 100%;
    height: auto;
  }
  #LpHero-{{ section.id }} .lp-hero__overlay {
    position: absolute;
    max-width: var(--lp-hero-content-max-width);
    top: var(--lp-hero-content-top);
    bottom: var(--lp-hero-content-bottom);
    left: var(--lp-hero-content-left);
    right: var(--lp-hero-content-right);
    transform: var(--lp-hero-content-transform);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    text-align: var(--lp-hero-text-align);
    width: 90%;
  }
  #LpHero-{{ section.id }} .lp-hero__eyebrow {
    margin: 0;
    color: var(--lp-hero-eyebrow-color);
    font-size: var(--lp-hero-eyebrow-size);
    font-family: {{ section.settings.eyebrow_font.family }}, {{ section.settings.eyebrow_font.fallback_families }};
    font-style: {{ section.settings.eyebrow_font.style }};
    font-weight: {{ section.settings.eyebrow_font.weight }};
    letter-spacing: 0.15em;
  }
  #LpHero-{{ section.id }} .lp-hero__eyebrow p {
    margin: 0;
  }
  #LpHero-{{ section.id }} .lp-hero__title {
    margin: 0;
    color: var(--lp-hero-title-color);
    font-size: var(--lp-hero-title-size);
    font-family: {{ section.settings.title_font.family }}, {{ section.settings.title_font.fallback_families }};
    font-style: {{ section.settings.title_font.style }};
    font-weight: {{ section.settings.title_font.weight }};
    letter-spacing: 0.1em;
    line-height: 1.3;
  }
  #LpHero-{{ section.id }} .lp-hero__title p,
  #LpHero-{{ section.id }} .lp-hero__title h1,
  #LpHero-{{ section.id }} .lp-hero__title h2,
  #LpHero-{{ section.id }} .lp-hero__title h3,
  #LpHero-{{ section.id }} .lp-hero__title h4,
  #LpHero-{{ section.id }} .lp-hero__title h5,
  #LpHero-{{ section.id }} .lp-hero__title h6 {
    margin: 0;
    font: inherit;
    color: inherit;
    letter-spacing: inherit;
  }
  {{ section.settings.eyebrow_font | font_face }}
  {{ section.settings.title_font | font_face }}
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div id="LpHero-{{ section.id }}" class="lp-hero section-{{ section.id }}-padding">
    {%- if section.settings.image_pc != blank or section.settings.image_sp != blank -%}
      <div class="lp-hero__media">
        <picture>
          {%- if section.settings.image_pc != blank -%}
            <source srcset="{{ section.settings.image_pc | img_url: '1920x' }}" media="(min-width: 750px)">
          {%- endif -%}
          {%- if section.settings.image_sp != blank -%}
            <img src="{{ section.settings.image_sp | img_url: '750x' }}" alt="{{ section.settings.image_sp.alt | escape }}" loading="eager" width="{{ section.settings.image_sp.width }}" height="{{ section.settings.image_sp.height }}">
          {%- elsif section.settings.image_pc != blank -%}
            <img src="{{ section.settings.image_pc | img_url: '1920x' }}" alt="{{ section.settings.image_pc.alt | escape }}" loading="eager" width="{{ section.settings.image_pc.width }}" height="{{ section.settings.image_pc.height }}">
          {%- endif -%}
        </picture>

        {%- if section.settings.logo_image != blank -%}
          <div class="lp-hero__logo">
            <img src="{{ section.settings.logo_image | img_url: '400x' }}" alt="{{ section.settings.logo_image.alt | escape }}" loading="lazy" width="{{ section.settings.logo_image.width }}" height="{{ section.settings.logo_image.height }}">
          </div>
        {%- endif -%}

        {%- if section.settings.eyebrow != blank or section.settings.title != blank -%}
          <div class="lp-hero__overlay{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
            {%- if section.settings.eyebrow != blank -%}
              <div class="lp-hero__eyebrow rte">{{ section.settings.eyebrow }}</div>
            {%- endif -%}
            {%- if section.settings.title != blank -%}
              <h1 class="lp-hero__title rte">{{ section.settings.title }}</h1>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

