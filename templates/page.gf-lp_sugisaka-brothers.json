    "gf_contents_common_sb_sec4": {
      "type": "gf-contents-common",
      "blocks": {
        "contents_title_sb_sec4": {
          "type": "contents-title",
          "settings": {
            "contents-subtitle": "",
            "contents-title": "<h2><strong>世界中をまたにかけるフライフィッシングのグローバルシーン</strong></h2>"
          }
        },
        "contents_image_sb_sec4_01": {
          "type": "contents-image",
          "settings": {
            "contents-image": "shopify://shop_images/sugisaka-bro_cuba.jpg",
            "contents-image-caption": "※キューバでターポンを釣ったシーン。",
            "image_bottom": 20,
            "contents-image-checkbox": false
          }
        },
        "contents_text_sb_sec4_01": {
          "type": "contents-text",
          "settings": {
            "contents-text": "<p>彼らの挑戦はファッションだけではありません。それは世界のフライフィッシングスポットで釣りをすること。<br/>フライフィッシング憧れの地フロリダをはじめ、二人が留学していたモンタナ、アイダホ、そしてアメリカフライフィッシング発祥の地と言われるキャッツキル(ニューヨーク)。その他にロシア、アマゾン、ボリビア、ベネズエラ、キューバ、パタゴニア(アルゼンチン)、モルジブ、アイスランド、ニュージーランド　クリスマス島(キリバス共和国)など世界を股にかけて釣りをしています。<br/>「フライフィッシングのグローバルシーンは確立されていて、常に新しいスポットの情報がやり取りされています。その情報をキャッチして、まだ開拓されていない世界中のスポットに向かいます。見たことのない場所を探検しながら魚を釣る。日本では想像もつかないようなサイズの魚もいてマジでワクワクしますよ。」<br/>彼らは、趣味としてだけでなく釣りを通して人生に影響を与えるような体験をしています。常にワクワクしながら次の釣りの事を考える。</p>"
          }
        },
        "contents_image_MCdXVK": {
          "type": "contents-image",
          "settings": {
            "contents-image": "shopify://shop_images/sugisaka-bro_bolivia.jpg",
            "contents-image-caption": "※アマゾン川（ボリビア）",
            "image_bottom": 20,
            "contents-image-checkbox": false
          }
        },
        "contents_image_gp4bg3": {
