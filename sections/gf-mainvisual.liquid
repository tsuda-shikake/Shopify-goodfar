    },
    {
      "type": "color",
      "id": "text_color_pc",
      "label": "テキストの色（PC）"
    },
    {
      "type": "color",
      "id": "text_color_sp",
      "label": "テキストの色（SP）"
    },
    {
      "type": "range",
      "id": "text_font_size_pc",
