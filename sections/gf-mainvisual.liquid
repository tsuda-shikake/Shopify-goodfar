{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 769px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .gf-mainvisual-{{ section.id }} .gf-mainvisual__text {
    font-family: {{ section.settings.text_font.family }}, {{ section.settings.text_font.fallback_families }};
    font-style: {{ section.settings.text_font.style }};
    font-weight: {{ section.settings.text_font.weight }};
  }
  {{ section.settings.text_font | font_face }}
{%- endstyle -%}

{%- liquid
  assign has_link = false
  if section.settings.link != blank
    assign has_link = true
  endif
-%}

<section class="gf-mainvisual gf-mainvisual-{{ section.id }} section-{{ section.id }}-padding">
  {%- if has_link -%}<a href="{{ section.settings.link }}" class="gf-mainvisual__link">{%- endif -%}
  <div class="gf-mainvisual__media">
    <picture>
      {%- if section.settings.image_pc != blank -%}
        <source srcset="{{ section.settings.image_pc | img_url: '1920x' }}" media="(min-width: 769px)">
      {%- endif -%}
      {%- if section.settings.image_sp != blank -%}
        <img src="{{ section.settings.image_sp | img_url: '768x' }}" alt="{{ section.settings.image_sp.alt | default: section.settings.image_pc.alt | escape }}" loading="lazy">
      {%- elsif section.settings.image_pc != blank -%}
        <img src="{{ section.settings.image_pc | img_url: '1920x' }}" alt="{{ section.settings.image_pc.alt | escape }}" loading="lazy">
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      {%- endif -%}
    </picture>
  </div>

  <div class="gf-mainvisual__overlay">
    {%- if section.settings.logo != blank -%}
      <div
        class="gf-mainvisual__logo gf-mainvisual__logo--sp-{{ section.settings.logo_position_sp }} gf-mainvisual__logo--pc-{{ section.settings.logo_position_pc }}"
        style="--gf-mainvisual-logo-width-sp: {{ section.settings.logo_width_sp }}px; --gf-mainvisual-logo-width-pc: {{ section.settings.logo_width_pc }}px;"
      >
        <img src="{{ section.settings.logo | img_url }}" alt="{{ section.settings.logo.alt | default: shop.name | escape }}">
      </div>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div
        class="gf-mainvisual__text gf-mainvisual__text--sp-{{ section.settings.text_position_sp }} gf-mainvisual__text--pc-{{ section.settings.text_position_pc }}"
        style="--gf-mainvisual-text-fs-sp: {{ section.settings.text_font_size_sp }}px; --gf-mainvisual-text-fs-pc: {{ section.settings.text_font_size_pc }}px;{% if section.settings.text_color_sp != blank %} --gf-mainvisual-text-color-sp: {{ section.settings.text_color_sp }};{% endif %}{% if section.settings.text_color_pc != blank %} --gf-mainvisual-text-color-pc: {{ section.settings.text_color_pc }};{% endif %}"
      >
        {{ section.settings.text }}
      </div>
    {%- endif -%}
  </div>
  {%- if has_link -%}</a>{%- endif -%}
</section>

{% schema %}
{
